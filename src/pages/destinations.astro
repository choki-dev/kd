---
// Destinations page (redesigned 2026-10-16): "the road east" route of all valleys, a sticky scroll-spy bar,
// one cinematic chapter per valley grouped by region, and an at-a-glance comparison table.
// Content in src/data/destinations.ts. "View tours" links open the Tours page filtered by that place (?place=<name>).
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.astro";
import Icon from "../components/Icon.astro";
import { tours } from "../data/home";
import { destinationList, destinationsPage } from "../data/destinations";

const { hero, intro, regions, glance, cta } = destinationsPage;
const toursIn = (place: string) => tours.filter((t) => t.places.includes(place)).length;
const toursHref = (name: string) => `/tours?place=${encodeURIComponent(name)}`;
const planHref = (name: string) => `/contact?place=${encodeURIComponent(name)}#form-title`;

// Valleys in road order, then grouped by region
const valleys = destinationList.map((d) => ({ ...d, count: toursIn(d.name) }));
const chapters = regions.map((r, ri) => ({ ...r, ri, items: valleys.filter((d) => d.region === r.name) }));
if (chapters.reduce((s, c) => s + c.items.length, 0) !== destinationList.length) {
  throw new Error("destinations.ts: every destination's `region` must match a name in destinationsPage.regions");
}
---

<BaseLayout title={destinationsPage.meta.title} description={destinationsPage.meta.description}>
  <Header />
  <main id="main">
    <PageHero {...hero} crumb="Destinations" />

    <!-- The road east: every valley in travel order -->
    <section class="section" aria-labelledby="dest-intro">
      <div class="container">
        <header class="section-head" data-reveal>
          <span class="script-accent">Where we travel</span>
          <h2 id="dest-intro" class="section-title">{intro.title}</h2>
          <p class="section-subtitle">{intro.subtitle}</p>
        </header>

        <div class="route" data-reveal>
          <div class="route-ends" aria-hidden="true">
            <span><Icon name="compass" size={15} /> West</span>
            <span>East <Icon name="arrow-right" size={15} /></span>
          </div>
          <ol class="route-list">
            {
              valleys.map((d) => (
                <li class="stop">
                  <a href={`#${d.id}`} class="stop-link">
                    <span class="stop-photo">
                      <Image src={d.image} alt="" width={176} height={176} widths={[96, 176]} sizes="88px" class="stop-img" />
                    </span>
                    <span class="stop-name">{d.name}</span>
                    <span class="stop-alt">{d.altitude.replace("About ", "")}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- Chapters: one per region, one cinematic card per valley -->
    <section class="section chapters" aria-label="Destinations by region">
      <nav class="spy" aria-label="Destinations">
        <div class="container">
          <ul class="spy-list">
            {
              valleys.map((d) => (
                <li>
                  <a href={`#${d.id}`} class="spy-link" data-spy={d.id}>
                    {d.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <div class="container">
        {
          chapters.map((c) => (
            <div class="region">
              <header class="region-head" data-reveal>
                <div>
                  <h2 class="region-title">{c.name}</h2>
                  <p class="region-text">{c.text}</p>
                </div>
              </header>

              {c.items.map((d, i) => (
                <article id={d.id} class="dest" aria-labelledby={`${d.id}-title`}>
                  <div class="dest-media" data-reveal>
                    <Image
                      src={d.image}
                      alt={d.alt}
                      width={1600}
                      height={700}
                      widths={[640, 960, 1280, 1600]}
                      sizes="(min-width: 1232px) 1200px, 96vw"
                      loading={c.ri === 0 && i === 0 ? "eager" : "lazy"}
                      class="dest-img"
                    />
                    <div class="dest-shade" />
                    <div class="dest-heading">
                      <div>
                        <span class="badge badge-glass">
                          <Icon name="map-pin" size={13} /> {d.region}
                        </span>
                        <h3 id={`${d.id}-title`} class="dest-title">
                          {d.name}
                        </h3>
                        <p class="dest-tagline">{d.tagline}</p>
                      </div>
                    </div>
                  </div>

                  <div class="dest-card" data-reveal style="--reveal-delay:120ms">
                    <div class="dest-about">
                      <p class="dest-p">{d.text}</p>
                      <div class="dest-actions">
                        {d.count > 0 ? (
                          <a href={toursHref(d.name)} class="btn btn-primary">
                            View {d.count} {d.count === 1 ? "tour" : "tours"} <Icon name="arrow-right" size={18} />
                          </a>
                        ) : null}
                        <a href={planHref(d.name)} class:list={["btn", d.count > 0 ? "btn-outline" : "btn-primary"]}>
                          Plan a trip here
                        </a>
                      </div>
                    </div>

                    <div class="dest-highlights">
                      <h4 class="dest-label">Don't miss</h4>
                      <ul>
                        {d.highlights.map((h) => (
                          <li>
                            <span class="check">
                              <Icon name="check" size={13} />
                            </span>
                            {h}
                          </li>
                        ))}
                      </ul>
                    </div>

                    <dl class="dest-facts">
                      <div>
                        <dt>
                          <Icon name="mountain" size={18} /> Altitude
                        </dt>
                        <dd>{d.altitude}</dd>
                      </div>
                      <div>
                        <dt>
                          <Icon name="compass" size={18} /> Getting there
                        </dt>
                        <dd>{d.access}</dd>
                      </div>
                      <div>
                        <dt>
                          <Icon name="star" size={18} /> Best for
                        </dt>
                        <dd>{d.bestFor}</dd>
                      </div>
                    </dl>
                  </div>
                </article>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <!-- At a glance -->
    <section class="section section-soft" aria-labelledby="glance-title">
      <div class="container">
        <header class="section-head" data-reveal>
          <span class="script-accent">Compare the valleys</span>
          <h2 id="glance-title" class="section-title">{glance.title}</h2>
          <p class="section-subtitle">{glance.subtitle}</p>
        </header>

        <div class="glance" data-reveal>
          <table>
            <thead>
              <tr>
                <th scope="col">Valley</th>
                <th scope="col">Altitude</th>
                <th scope="col">Getting there</th>
                <th scope="col">Best for</th>
                <th scope="col"><span class="sr-only">Tours</span></th>
              </tr>
            </thead>
            <tbody>
              {
                valleys.map((d) => (
                  <tr>
                    <th scope="row">
                      <a href={`#${d.id}`} class="glance-name">
                        <span>
                          {d.name}
                          <small>{d.region}</small>
                        </span>
                      </a>
                    </th>
                    <td data-label="Altitude">{d.altitude}</td>
                    <td data-label="Getting there">{d.access}</td>
                    <td data-label="Best for">{d.bestFor}</td>
                    <td class="glance-cta">
                      {d.count > 0 ? (
                        <a href={toursHref(d.name)}>
                          {d.count} {d.count === 1 ? "tour" : "tours"} <Icon name="arrow-right" size={16} />
                        </a>
                      ) : (
                        <a href={planHref(d.name)}>
                          Plan a trip <Icon name="arrow-right" size={16} />
                        </a>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <CtaBand {...cta} primary={{ label: "Ask our team", href: "/contact" }} secondary={{ label: "Browse all tours", href: "/tours" }} />
  </main>
  <Footer />
  <ChatWidget />
</BaseLayout>

<script>
  // Scroll spy: highlight the valley in view in the sticky bar, and keep that chip scrolled into the bar
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".spy-link")];
  const list = document.querySelector<HTMLElement>(".spy-list");
  const setActive = (id: string) => {
    links.forEach((a) => {
      const on = a.dataset.spy === id;
      a.classList.toggle("is-active", on);
      if (on) {
        a.setAttribute("aria-current", "location");
        if (list) {
          const left = a.offsetLeft - (list.clientWidth - a.offsetWidth) / 2;
          list.scrollTo({ left, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        }
      } else a.removeAttribute("aria-current");
    });
  };
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
    { rootMargin: "-45% 0px -50% 0px" },
  );
  document.querySelectorAll<HTMLElement>(".dest").forEach((el) => io.observe(el));
</script>

<style>
  /* ---------- The road east ---------- */
  .route {
    position: relative;
  }
  .route-ends {
    display: flex;
    justify-content: space-between;
    margin-bottom: 18px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .route-ends span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .route-list {
    list-style: none;
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(118px, 1fr);
    gap: 8px;
    margin: 0 calc(var(--gutter) * -1);
    padding: 4px var(--gutter) 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .stop {
    position: relative;
    scroll-snap-align: start;
  }
  /* Dashed road between the photo centres */
  .stop:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 48px;
    left: calc(50% + 52px);
    right: calc(-50% + 52px - 8px);
    border-top: 2px dashed var(--bluegray);
    z-index: 0;
  }
  .stop-link {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 4px;
  }
  .stop-photo {
    position: relative;
    display: block;
    width: 96px;
    height: 96px;
    padding: 4px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: var(--shadow);
    transition:
      box-shadow 0.35s var(--ease),
      transform 0.35s var(--ease);
  }
  .stop-photo :global(.stop-img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .stop-name {
    margin-top: 14px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--primary);
    transition: color 0.3s;
  }
  .stop-alt {
    margin-top: 4px;
    font-size: 13px;
    color: var(--muted);
  }
  .stop-link:hover .stop-photo,
  .stop-link:focus-visible .stop-photo {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 3px var(--accent),
      var(--shadow-lg);
  }
  .stop-link:hover .stop-name {
    color: var(--accent);
  }

  /* ---------- Sticky scroll-spy bar ---------- */
  .chapters {
    position: relative;
  }
  .spy {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    margin-bottom: 48px;
    padding-block: 10px;
    background: rgba(242, 246, 247, 0.88); /* --cloud-mist, translucent */
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-block: 1px solid var(--line);
  }
  .spy-list {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .spy-list::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 1200px) {
    .spy-list {
      justify-content: center;
    }
  }
  .spy-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--primary);
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .spy-link:hover {
    color: var(--accent);
  }
  .spy-link.is-active {
    background: var(--primary);
    color: var(--white);
  }

  /* ---------- Region chapters ---------- */
  .region + .region {
    margin-top: 96px;
  }
  .region-head {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--bluegray);
  }
  .region-title {
    font-size: clamp(26px, 2vw + 16px, 38px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .region-text {
    max-width: 640px;
    margin-top: 8px;
    color: var(--muted);
  }
  @media (max-width: 575px) {
    .region-head {
      flex-direction: column;
      gap: 12px;
    }
  }

  /* ---------- Destination chapter ---------- */
  .dest {
    scroll-margin-top: calc(var(--header-h) + 76px);
  }
  .dest + .dest {
    margin-top: 72px;
  }
  @media (min-width: 992px) {
    .dest + .dest {
      margin-top: 96px;
    }
  }
  .dest-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--primary);
    isolation: isolate;
  }
  .dest-media :global(.dest-img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  @media (min-width: 576px) {
    .dest-media :global(.dest-img) {
      aspect-ratio: 16 / 9;
    }
  }
  @media (min-width: 992px) {
    .dest-media :global(.dest-img) {
      aspect-ratio: 16 / 7;
    }
  }
  .dest:hover .dest-media :global(.dest-img) {
    transform: scale(1.04);
  }
  .dest-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.25) 45%, transparent 70%),
      linear-gradient(90deg, rgba(11, 61, 74, 0.45), transparent 60%);
  }
  .dest-heading {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    gap: 20px;
    padding: 24px 24px 52px; /* bottom = card overlap (28px) + 24px */
    color: var(--white);
  }
  @media (min-width: 768px) {
    .dest-heading {
      padding: 32px 36px 72px;
    }
  }
  @media (min-width: 992px) {
    .dest-heading {
      padding: 40px 48px 120px;
    }
  }
  .dest-title {
    margin-top: 12px;
    font-size: clamp(30px, 2.6vw + 18px, 56px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--white);
  }
  .dest-tagline {
    margin-top: 6px;
    max-width: 560px;
    font-size: clamp(15px, 0.3vw + 14px, 18px);
    color: rgba(255, 255, 255, 0.88);
  }

  /* White card overlapping the bottom of the photo */
  .dest-card {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 28px;
    margin: -28px 12px 0;
    padding: 28px 22px;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }
  .dest-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 28px;
    width: 72px;
    height: 4px;
    border-radius: 0 0 999px 999px;
    background: linear-gradient(90deg, var(--charcoal) 0 25%, var(--primary) 25% 50%, var(--accent) 50% 75%, var(--bluegray) 75% 100%);
  }
  @media (min-width: 768px) {
    .dest-card {
      grid-template-columns: 1fr 1fr;
      margin: -40px 24px 0;
      padding: 36px;
    }
    .dest-about {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 992px) {
    .dest-card {
      grid-template-columns: 1.3fr 1fr 0.9fr;
      gap: 40px;
      margin: -88px 48px 0;
      padding: 40px 44px;
    }
    .dest-about {
      grid-column: auto;
    }
  }
  .dest-p {
    color: var(--muted);
  }
  .dest-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .btn-outline {
    border: 1px solid var(--bluegray);
    color: var(--primary);
  }
  .btn-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .dest-label {
    margin-bottom: 14px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .dest-highlights ul {
    display: grid;
    gap: 12px;
  }
  .dest-highlights li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.45;
  }
  .check {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--soft);
    color: var(--accent);
  }

  .dest-facts {
    display: grid;
    gap: 2px;
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    align-self: start;
  }
  .dest-facts > div {
    padding: 14px 16px;
    background: var(--cloud-mist);
  }
  .dest-facts dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .dest-facts dd {
    margin: 4px 0 0 26px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--primary);
  }

  /* ---------- At a glance ---------- */
  .glance {
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .glance table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .glance thead th {
    padding: 16px 20px;
    background: var(--primary);
    color: var(--white);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: left;
  }
  .glance tbody tr + tr {
    border-top: 1px solid var(--line);
  }
  .glance tbody tr {
    transition: background-color 0.25s;
  }
  .glance tbody tr:hover {
    background: var(--cloud-mist);
  }
  .glance td,
  .glance tbody th {
    padding: 16px 20px;
    text-align: left;
    vertical-align: middle;
    font-weight: 400;
  }
  .glance td[data-label="Altitude"] {
    white-space: nowrap;
  }
  .glance-name {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    color: var(--primary);
  }
  .glance-name small {
    display: block;
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
  }
  .glance-name:hover {
    color: var(--accent);
  }
  .glance-cta {
    text-align: right !important;
    white-space: nowrap;
  }
  .glance-cta a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--soft);
    font-size: 14px;
    font-weight: 500;
    color: var(--primary);
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .glance-cta a:hover {
    background: var(--accent);
    color: var(--white);
  }

  /* Small screens: each row becomes a card */
  @media (max-width: 767px) {
    .glance {
      background: transparent;
      box-shadow: none;
      border-radius: 0;
    }
    .glance thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
    .glance table,
    .glance tbody,
    .glance tr,
    .glance th,
    .glance td {
      display: block;
    }
    .glance tbody {
      display: grid;
      gap: 14px;
    }
    .glance tbody tr,
    .glance tbody tr + tr {
      padding: 18px 20px;
      border: 0;
      border-radius: var(--radius-sm);
      background: var(--white);
      box-shadow: var(--shadow);
    }
    .glance td,
    .glance tbody th {
      padding: 0;
    }
    .glance tbody th {
      margin-bottom: 10px;
    }
    .glance td[data-label] {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 8px 0;
      border-top: 1px solid var(--line);
      font-size: 14px;
      text-align: right;
    }
    .glance td[data-label]::before {
      content: attr(data-label);
      flex: none;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      text-align: left;
    }
    .glance-cta {
      margin-top: 10px;
      text-align: left !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dest:hover .dest-media :global(.dest-img),
    .stop-link:hover .stop-photo {
      transform: none;
    }
  }
</style>
