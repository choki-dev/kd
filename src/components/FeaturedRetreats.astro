---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { featuredRetreats, tourHref } from "../data/home";
---

<section class="section retreats" aria-labelledby="retreats-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <h2 id="retreats-title" class="section-title">Signature journeys through the Thunder Dragon kingdom</h2>
      <p class="section-subtitle">Handpicked itineraries with private Bhutanese guides, boutique hotels and farmhouse stays.</p>
    </header>

    <!-- 3 columns on desktop; swipeable slider on smaller screens -->
    <ul class="retreat-track" aria-label="Featured retreats">
      {
        featuredRetreats.map((t, i) => (
          <li class="retreat-slide" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <article class="retreat">
              <Image
                src={t.image}
                alt={t.alt}
                width={760}
                height={1000}
                widths={[320, 480, 640, 760]}
                sizes="(min-width: 1200px) 380px, (min-width: 992px) 30vw, (min-width: 576px) 60vw, 84vw"
                loading="lazy"
                class="retreat-img"
              />
              <div class="retreat-shade" />
              <div class="retreat-top">
                <div class="retreat-badges">
                  <span class="badge badge-accent">Featured</span>
                </div>
              </div>
              <div class="retreat-body">
                <div class="retreat-row">
                  <span class="retreat-city">
                    <Icon name="map-pin" size={17} /> {t.city}
                  </span>
                </div>
                <h3 class="retreat-title">
                  <a href={tourHref(t)}>{t.title}</a>
                </h3>
                <div class="retreat-row retreat-foot">
                  <span>
                    Up to {t.people} guests · {t.days} days
                  </span>
                  <span class="retreat-price">US${t.price.toLocaleString("en-US")}</span>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .retreat-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    margin-inline: calc(var(--gutter) * -1);
    padding: 4px var(--gutter) 12px;
    scrollbar-width: none;
  }
  .retreat-track::-webkit-scrollbar {
    display: none;
  }
  .retreat-slide {
    flex: 0 0 84%;
    scroll-snap-align: start;
  }
  @media (min-width: 576px) {
    .retreat-slide {
      flex-basis: 60%;
    }
  }
  @media (min-width: 992px) {
    .retreat-track {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
      overflow: visible;
      margin-inline: 0;
      padding: 0;
    }
  }

  .retreat {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 20px;
    color: var(--white);
  }
  @media (min-width: 1200px) {
    .retreat {
      aspect-ratio: 380 / 520;
    }
  }
  .retreat :global(.retreat-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .retreat:hover :global(.retreat-img) {
    transform: scale(1.06);
  }
  .retreat-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 61, 74, 0.3) 0%, rgba(11, 61, 74, 0) 30%, rgba(11, 61, 74, 0.15) 50%, rgba(11, 61, 74, 0.9) 100%);
  }
  .retreat-top {
    position: absolute;
    inset: 18px 18px auto;
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .retreat-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .retreat-body {
    position: absolute;
    inset: auto 22px 22px;
  }
  .retreat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .retreat-city {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
  }
  .retreat-title {
    margin: 10px 0 14px;
    font-size: clamp(16px, 0.4vw + 14px, 19px);
    line-height: 1.3;
    color: var(--white);
  }
  .retreat-title a:hover {
    color: var(--accent-tint);
  }
  .retreat-foot {
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 15px;
    color: rgba(255, 255, 255, 0.85);
  }
  .retreat-price {
    font-size: 24px;
    font-weight: 700;
    color: var(--white);
  }
</style>
