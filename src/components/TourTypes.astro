---
import Icon from "./Icon.astro";
import { tourTypes } from "../data/home";
---

<section class="section types" aria-labelledby="types-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <h2 id="types-title" class="section-title">Ways to experience Bhutan</h2>
      <p class="section-subtitle">Culture, festivals, Himalayan treks and quiet pilgrimages — choose the journey that suits you.</p>
    </header>

    <ul class="types-grid">
      {
        tourTypes.map((t, i) => (
          <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <a href={`/tours?type=${t.name}`} class="type">
              <span class="type-icon">
                <Icon name={t.icon} size={40} strokeWidth={1.3} />
              </span>
              <span class="type-name">{t.name}</span>
              <span class="type-count">{t.count} {t.count === 1 ? "Tour" : "Tours"}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .types-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 16px;
  }
  @media (min-width: 576px) {
    .types-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 992px) {
    .types-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  .type {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .type-icon {
    display: grid;
    place-items: center;
    width: 128px;
    height: 128px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: var(--soft);
    color: var(--accent);
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease),
      transform 0.35s var(--ease);
  }
  @media (min-width: 1200px) {
    .type-icon {
      width: 150px;
      height: 150px;
    }
  }
  .type:hover .type-icon,
  .type:focus-visible .type-icon {
    background: var(--accent);
    color: var(--white);
    transform: translateY(-4px);
  }
  .type-name {
    font-size: 20px;
    font-weight: 500;
    color: var(--primary);
    transition: color 0.3s;
  }
  .type:hover .type-name {
    color: var(--accent);
  }
  .type-count {
    margin-top: 2px;
    color: var(--muted);
    font-size: 15px;
  }
</style>
