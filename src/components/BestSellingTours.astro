---
import TourCard from "./TourCard.astro";
import Icon from "./Icon.astro";
import { tourFilters, tours } from "../data/home";
---

<section id="tours" class="section best" aria-labelledby="best-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <h2 id="best-title" class="section-title">Our most popular Bhutan tours</h2>
      <p class="section-subtitle">The itineraries our guests book again and again — private guides, comfortable hotels and unforgettable valleys.</p>
    </header>

    <!-- Filter tabs -->
    <div class="tabs" role="group" aria-label="Filter tours by type" data-reveal>
      {
        tourFilters.map((f, i) => (
          <button type="button" class="tab" aria-pressed={i === 0 ? "true" : "false"} data-filter={f}>
            {f}
          </button>
        ))
      }
    </div>

    <ul class="tour-grid" data-tour-grid>
      {
        tours.map((t, i) => (
          <li data-category={t.category} data-reveal style={`--reveal-delay:${(i % 4) * 80}ms`}>
            <TourCard tour={t} />
          </li>
        ))
      }
    </ul>
    <div class="more" data-reveal>
      <a href="/tours" class="btn btn-primary">View all tours <Icon name="arrow-right" size={18} /></a>
    </div>
    <p class="empty" hidden data-empty>No tours of this type right now — check back soon.</p>
    <p class="sr-only" aria-live="polite" data-tour-status></p>
  </div>
</section>

<style>
  .best {
    padding-top: 0;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 40px;
  }
  .tab {
    min-height: 46px;
    padding: 0 24px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--white);
    font-weight: 500;
    font-size: 15px;
    color: var(--primary);
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .tab:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tab[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--white);
  }
  .tour-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .tour-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .tour-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }
  }
  .tour-grid li[hidden] {
    display: none;
  }
  .more {
    margin-top: 48px;
    text-align: center;
  }
  .empty {
    text-align: center;
    color: var(--muted);
  }
</style>

<script>
  // Filter tabs: show cards whose category matches; the search bar can also pick a tab ("tours:filter" event)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const items = [...document.querySelectorAll<HTMLElement>("[data-tour-grid] > li")];
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const status = document.querySelector<HTMLElement>("[data-tour-status]");

  const apply = (filter: string) => {
    const tab = tabs.find((t) => t.dataset.filter === filter) ?? tabs[0];
    tabs.forEach((t) => t.setAttribute("aria-pressed", String(t === tab)));
    let shown = 0;
    items.forEach((li) => {
      const match = tab.dataset.filter === "View All" || li.dataset.category === tab.dataset.filter;
      li.hidden = !match;
      if (match) {
        shown++;
        li.classList.add("is-visible"); // cards revealed by filtering shouldn't wait for the scroll animation
      }
    });
    if (empty) empty.hidden = shown > 0;
    if (status) status.textContent = `${shown} tour${shown === 1 ? "" : "s"} shown`;
  };

  tabs.forEach((t) => t.addEventListener("click", () => apply(t.dataset.filter!)));
  document.addEventListener("tours:filter", (e) => apply((e as CustomEvent<string>).detail));
</script>
