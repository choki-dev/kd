---
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
import { destinations } from "../data/home";
import { destinationList } from "../data/destinations";

// Image size per tile shape
const sizes = {
  punakha: { w: 760, h: 1080 },
  trongsa: { w: 760, h: 1080 },
  thimphu: { w: 1200, h: 620 },
  bumthang: { w: 600, h: 600 },
  paro: { w: 600, h: 600 },
} as const;
---

<section id="destinations" class="section destinations" aria-labelledby="dest-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <span class="script-accent">Explore the valleys</span>
      <h2 id="dest-title" class="section-title">Discover Bhutan's most beloved places</h2>
      <p class="section-subtitle">From the gateway valley of Paro to the temples of Bumthang — every valley has its own festivals, dzongs and trails.</p>
    </header>

    <ul class="bento">
      {
        destinations.map((d, i) => (
          <li class={`tile tile-${d.area}`} data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <a href={`/destinations#${d.area}`} class="tile-link">
              {/* decorative: the link is named by the valley name, so screen readers don't hear the photo description first */}
              <Photo
                src={d.image}
                alt=""
                width={sizes[d.area].w}
                height={sizes[d.area].h}
                widths={[360, 560, sizes[d.area].w]}
                sizes="(min-width: 992px) 33vw, (min-width: 576px) 50vw, 100vw"
                loading="lazy"
                class="tile-img"
              />
              <strong class="tile-name">{d.name}</strong>
              <span class="tile-arrow" aria-hidden="true">
                <Icon name="arrow-right" size={18} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="dest-more" data-reveal>
      <a href="/destinations" class="btn btn-primary">View all {destinationList.length} destinations <Icon name="arrow-right" size={18} /></a>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: 280px;
    gap: 16px;
  }
  @media (min-width: 576px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
      grid-template-areas:
        "punakha thimphu"
        "punakha bumthang"
        "trongsa paro"
        "trongsa .";
      grid-auto-rows: 260px;
    }
    .tile-punakha { grid-area: punakha; }
    .tile-thimphu { grid-area: thimphu; }
    .tile-bumthang { grid-area: bumthang; }
    .tile-paro { grid-area: paro; }
    .tile-trongsa { grid-area: trongsa; }
  }
  @media (min-width: 576px) and (max-width: 991.98px) {
    /* fill the empty cell: Paro spans the last two rows */
    .bento {
      grid-template-areas:
        "punakha thimphu"
        "punakha bumthang"
        "trongsa paro"
        "trongsa paro";
    }
  }
  @media (min-width: 992px) {
    .bento {
      grid-template-columns: 1fr 1fr 1fr 1fr;
      grid-template-areas:
        "punakha thimphu thimphu trongsa"
        "punakha bumthang paro trongsa";
      grid-auto-rows: 290px;
      gap: 24px;
    }
  }
  @media (min-width: 1200px) {
    .bento {
      grid-auto-rows: 310px;
      gap: 30px;
    }
  }

  .tile-link {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 20px;
    color: var(--white);
    isolation: isolate;
  }
  .tile-link :global(.tile-img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  /* Black shade rising from the bottom so the name reads on any photo; deepens on hover */
  .tile-link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.45) 70%, rgba(0, 0, 0, 0.8) 100%);
    transition: opacity 0.4s var(--ease);
  }
  .tile-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(0, 0, 0, 0.2);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .tile-link:hover :global(.tile-img),
  .tile-link:focus-visible :global(.tile-img) {
    transform: scale(1.07);
  }
  .tile-link:hover::after,
  .tile-link:focus-visible::after {
    opacity: 1;
  }

  .tile-name {
    position: absolute;
    left: 22px;
    right: 76px;
    bottom: 26px;
    font-size: clamp(24px, 0.8vw + 18px, 30px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  /* Round arrow, bottom right: glass at rest, Global Tide and pointing forward on hover */
  .tile-arrow {
    position: absolute;
    right: 20px;
    bottom: 22px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }
  .tile-arrow :global(svg) {
    transform: rotate(-45deg);
    transition: transform 0.35s var(--ease);
  }
  .tile-link:hover .tile-arrow,
  .tile-link:focus-visible .tile-arrow {
    background: var(--accent);
    border-color: var(--accent);
  }
  .tile-link:hover .tile-arrow :global(svg),
  .tile-link:focus-visible .tile-arrow :global(svg) {
    transform: rotate(0);
  }

  .dest-more {
    margin-top: 48px;
    text-align: center;
  }
</style>
