---
// Reusable tour card (best-selling grid). `data-category` drives the filter tabs.
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { tourHref, type Tour } from "../data/home";

interface Props {
  tour: Tour;
}

const { tour } = Astro.props;
// Cards show just the tour name ("Punakha Valley Cultural Journey"); the full "name: subtitle" title is on the detail page
const name = tour.title.split(/:\s*/)[0];
---

<article class="tour-card" data-category={tour.category}>
  <div class="tour-media">
    <Image
      src={tour.image}
      alt={tour.alt}
      width={800}
      height={800}
      widths={[320, 480, 640, 800]}
      sizes="(min-width: 1200px) 380px, (min-width: 992px) 30vw, (min-width: 768px) 45vw, 92vw"
      loading="lazy"
      class="tour-img"
    />
    <div class="tour-badges">
      {tour.featured && <span class="badge badge-accent">Featured</span>}
    </div>
  </div>

  <div class="tour-body">
    <h3 class="tour-title"><a href={tourHref(tour)}>{name}</a></h3>
    <ul class="tour-meta">
      <li><Icon name="users" size={17} /> Up to {tour.people}</li>
      <li><Icon name="clock" size={17} /> {tour.days} days</li>
    </ul>
    <div class="tour-foot">
      <span class="tour-city"><Icon name="map-pin" size={17} /> {tour.city}</span>
      <span class="tour-cta" aria-hidden="true">View tour <Icon name="arrow-right" size={16} /></span>
    </div>
  </div>
</article>

<style>
  .tour-card {
    position: relative; /* the title link stretches over the whole card */
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .tour-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .tour-media {
    position: relative;
    aspect-ratio: 1 / 1; /* tall photo, on request */
    overflow: hidden;
  }
  .tour-media :global(.tour-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .tour-card:hover :global(.tour-img) {
    transform: scale(1.07);
  }
  .tour-badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tour-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 18px 20px 20px;
  }
  .tour-title {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.7em; /* reserve 2 lines so the meta row lines up across a row of cards */
  }
  .tour-title a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .tour-card:hover .tour-title a,
  .tour-title a:hover {
    color: var(--accent);
  }
  .tour-meta {
    display: flex;
    gap: 18px;
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
  }
  .tour-meta li,
  .tour-city {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .tour-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    margin-block-start: 16px;
  }
  .tour-city {
    color: var(--text);
    font-size: 15px;
  }
  .tour-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 15px;
    font-weight: 500;
  }
  .tour-cta :global(svg) {
    transition: transform 0.3s var(--ease);
  }
  .tour-card:hover .tour-cta :global(svg) {
    transform: translateX(4px);
  }

</style>
