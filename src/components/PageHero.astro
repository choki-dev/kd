---
// Inner-page banner: photo + deep-teal overlay, script tagline + serif title (same text styles as the homepage hero) and breadcrumb.
// Sits under the transparent header, like the homepage hero.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { breadcrumbSchema, jsonLd } from "../utils/seo";

interface Props {
  title: string;
  kicker: string;
  text?: string;
  image: ImageMetadata;
  alt: string;
  crumb: string; // current page name in the breadcrumb
  parents?: { label: string; href: string }[]; // breadcrumb steps between Home and the current page
  overlap?: boolean; // cards overlap the bottom edge (Contact, tour detail): lifts the scroll cue above them
}

const { title, kicker, text, image, alt, crumb, parents = [], overlap = false } = Astro.props;

// Same trail as the visible breadcrumb, for search results (current page = this URL without the base path)
const here = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, "").length) || "/";
const crumbs = breadcrumbSchema([{ label: "Home", href: "/" }, ...parents, { label: crumb, href: here }]);
---

<script type="application/ld+json" set:html={jsonLd(crumbs)} />

<section class:list={["page-hero", { "has-overlap": overlap }]}>
  <!-- AVIF with a WebP fallback: the banner is the largest image on every inner page -->
  <Picture src={image} formats={["avif"]} fallbackFormat="webp" alt={alt} width={1920} height={1080} widths={[640, 960, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="page-hero-img" />
  <div class="page-hero-overlay"></div>
  <div class="container page-hero-content">
    <p class="page-hero-kicker">{kicker}</p>
    <h1 class="page-hero-title">{title}</h1>
    {text && <p class="page-hero-text">{text}</p>}
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        {
          parents.map((p) => (
            <>
              <li aria-hidden="true"><Icon name="chevron-right" size={14} /></li>
              <li><a href={p.href}>{p.label}</a></li>
            </>
          ))
        }
        <li aria-hidden="true"><Icon name="chevron-right" size={14} /></li>
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
  </div>
  <a href="#after-hero" class="page-hero-scroll" aria-label="Scroll to content"><span class="page-hero-mouse" aria-hidden="true"></span><span aria-hidden="true">Scroll</span></a>
</section>
<span id="after-hero"></span>

<style>
  /* Full-screen banner, like the homepage hero */
  .page-hero {
    position: relative;
    display: flex;
    align-items: center;
    height: 100vh;
    height: 100svh;
    min-height: 600px;
    max-height: 1100px;
    overflow: hidden;
    background: var(--primary);
    color: var(--white);
  }
  @media (max-height: 600px) {
    .page-hero {
      height: auto;
    }
  }
  .page-hero :global(.page-hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Light overlay so more of the photo shows: darker only behind the header, softly behind the centred text,
     and at the bottom edge (where the facts/contact cards overlap) */
  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 48%, rgba(0, 0, 0, 0.3), transparent 75%), /* homepage-hero shade behind the text */
      radial-gradient(ellipse 60% 45% at 50% 52%, rgba(11, 61, 74, 0.5), transparent 78%),
      linear-gradient(180deg, rgba(11, 61, 74, 0.6) 0%, rgba(11, 61, 74, 0) 24%, rgba(11, 61, 74, 0) 70%, rgba(11, 61, 74, 0.45) 100%);
  }
  .page-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-top: calc(var(--header-h) + 48px);
    padding-bottom: 64px;
  }
  /* Same text as the homepage hero (Hero.astro, on request 2026-10-16):
     Parisienne script tagline in the teal tint above a white Playfair Display headline */
  .page-hero-kicker {
    font-family: var(--font-display-script);
    font-size: clamp(30px, 1.6vw + 22px, 44px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--accent-tint);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }
  .page-hero-title {
    max-width: 860px;
    margin: 8px auto 0;
    font-family: var(--font-display-serif);
    font-size: clamp(30px, 3vw + 12px, 56px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--white);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.3);
  }
  .page-hero-text {
    max-width: 620px;
    margin: 22px auto 0;
    font-size: clamp(14px, 0.3vw + 13px, 16px);
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 10px rgba(11, 61, 74, 0.6);
  }
  .crumbs {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    padding: 10px 20px;
    border-radius: 999px;
    background: rgba(11, 61, 74, 0.45); /* teal glass: readable on bright photos too */
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 14px;
    font-weight: 500;
  }
  .crumbs li {
    display: inline-flex;
  }
  .crumbs a:hover {
    color: var(--accent-tint);
  }
  .crumbs [aria-current] {
    color: var(--accent-tint);
  }

  /* ---------- Motion polish (2026-10-16): slow photo zoom, staggered text entrance, scroll cue ---------- */
  .page-hero :global(.page-hero-img) {
    animation: ph-zoom 14s var(--ease) both;
  }
  @keyframes ph-zoom {
    from { transform: scale(1.12); }
    to { transform: scale(1); }
  }
  .page-hero-content > * {
    animation: ph-rise 0.9s var(--ease) both;
  }
  .page-hero-content > :nth-child(2) { animation-delay: 0.12s; }
  .page-hero-content > :nth-child(3) { animation-delay: 0.24s; }
  .page-hero-content > :nth-child(4) { animation-delay: 0.36s; }
  @keyframes ph-rise {
    from { opacity: 0; transform: translateY(24px); }
  }
  /* Thin divider under the title: the brand's four-colour bar */
  .page-hero-title::after {
    content: "";
    display: block;
    width: 72px;
    height: 3px;
    margin: 20px auto 0;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--accent-tint) 0 25%, var(--white) 25% 50%, var(--bluegray) 50% 75%, var(--accent) 75%);
  }
  .page-hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 8px;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    animation: ph-rise 0.9s 0.6s var(--ease) both;
  }
  .page-hero-scroll:hover {
    color: var(--white);
  }
  .page-hero-mouse {
    position: relative;
    width: 24px;
    height: 38px;
    border: 2px solid currentColor;
    border-radius: 14px;
  }
  .page-hero-mouse::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 7px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: currentColor;
    animation: ph-wheel 1.8s ease-in-out infinite;
  }
  @keyframes ph-wheel {
    0% { opacity: 0; transform: translateY(-3px); }
    40% { opacity: 1; }
    100% { opacity: 0; transform: translateY(10px); }
  }
  /* Hidden where the banner is short or cards overlap its bottom edge */
  @media (max-width: 767px), (max-height: 700px) {
    .page-hero-scroll {
      display: none;
    }
  }
  .page-hero.has-overlap .page-hero-scroll {
    bottom: 96px;
  }
  @media (prefers-reduced-motion: reduce) {
    .page-hero :global(.page-hero-img),
    .page-hero-content > *,
    .page-hero-scroll,
    .page-hero-mouse::after {
      animation: none;
    }
  }
</style>
