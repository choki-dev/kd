---
// Floating chat widget (bottom-right corner, every page). Replaced the back-to-top button on request (2026-10-16).
// The round button opens a small chat card with WhatsApp and Messenger buttons.
import { site, whatsappHref } from "../data/home";

const waHref = whatsappHref();
const messengerHref = `https://m.me/${site.messenger}`;

// Brand glyphs (Simple Icons, 24 × 24)
const whatsappGlyph =
  "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z";
const messengerGlyph =
  "M.001 11.639C.001 4.949 5.241 0 12.001 0S24 4.95 24 11.639c0 6.689-5.24 11.638-12 11.638-1.21 0-2.38-.16-3.47-.46a.96.96 0 0 0-.64.05l-2.39 1.05a.96.96 0 0 1-1.35-.85l-.07-2.14a.97.97 0 0 0-.32-.68A11.39 11.389 0 0 1 .002 11.64zm8.32-2.19-3.52 5.6c-.35.53.32 1.139.82.75l3.79-2.87c.26-.2.6-.2.87 0l2.8 2.1c.84.63 2.04.4 2.6-.48l3.52-5.6c.35-.53-.32-1.13-.82-.75l-3.79 2.87c-.25.2-.6.2-.86 0l-2.8-2.1a1.8 1.8 0 0 0-2.61.48z";
const closePath = "M18 6 6 18M6 6l12 12";
---

<div class="chat" data-chat>
  <div class="chat-card" id="chat-card" role="dialog" aria-labelledby="chat-title" hidden data-chat-card>
    <div class="chat-head">
      <span class="chat-avatar" aria-hidden="true"><img src="/favicon.png" alt="" width="28" height="28" /></span>
      <span>
        <strong id="chat-title">{site.name}</strong>
        <small>Chat with us on WhatsApp or Messenger</small>
      </span>
      <button type="button" class="chat-close" aria-label="Close chat" data-chat-close>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={closePath} stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
    <div class="chat-body">
      <p class="chat-bubble">Kuzuzangpo la! 👋<br />How can we help you plan your trip to Bhutan?</p>
    </div>
    <div class="chat-actions">
      <a class="chat-btn chat-btn-wa" href={waHref} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={whatsappGlyph} /></svg>
        Chat on WhatsApp
      </a>
      <a class="chat-btn chat-btn-ms" href={messengerHref} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={messengerGlyph} /></svg>
        Chat on Messenger
      </a>
    </div>
  </div>

  <button type="button" class="chat-toggle" aria-label="Chat with us" aria-expanded="false" aria-controls="chat-card" data-chat-toggle>
    <!-- Closed: the two app icons take turns; open: a close cross -->
    <svg class="chat-icon chat-icon-wa" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d={whatsappGlyph} /></svg>
    <svg class="chat-icon chat-icon-ms" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d={messengerGlyph} /></svg>
    <svg class="chat-x" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={closePath} stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
  </button>
</div>

<style>
  .chat {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
  }

  /* Toggle: green with the WhatsApp icon, then blue with the Messenger icon, in turn */
  .chat-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--whatsapp);
    color: var(--white);
    box-shadow: 0 10px 28px rgba(11, 61, 74, 0.3);
    animation: chat-bg 8s ease-in-out infinite;
    transition: transform 0.3s var(--ease);
  }
  .chat-toggle:hover {
    transform: scale(1.06);
  }
  .chat-toggle > svg {
    grid-area: 1 / 1;
  }
  .chat-icon-wa {
    animation: chat-swap 8s ease-in-out infinite;
  }
  .chat-icon-ms {
    animation: chat-swap 8s ease-in-out -4s infinite;
  }
  @keyframes chat-bg {
    0%, 42% { background-color: var(--whatsapp); }
    50%, 92% { background-color: var(--messenger); }
    100% { background-color: var(--whatsapp); }
  }
  @keyframes chat-swap {
    0%, 42% { opacity: 1; transform: none; }
    50%, 92% { opacity: 0; transform: scale(0.6) rotate(-30deg); }
    100% { opacity: 1; transform: none; }
  }
  /* Soft pulse ring to draw the eye */
  .chat-toggle::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: inherit;
    z-index: -1;
    animation: chat-pulse 2.4s ease-out infinite;
  }
  @keyframes chat-pulse {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.6); opacity: 0; }
  }
  .chat-x {
    display: none;
  }
  .chat.is-open .chat-toggle {
    animation: none;
    background: var(--primary);
  }
  .chat.is-open .chat-toggle::before {
    animation: none;
    opacity: 0;
  }
  .chat.is-open .chat-icon {
    display: none;
  }
  .chat.is-open .chat-x {
    display: block;
  }

  .chat-card {
    width: min(320px, calc(100vw - 40px));
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-lg);
    transform-origin: bottom right;
    animation: chat-in 0.25s var(--ease);
  }
  .chat-card[hidden] {
    display: none;
  }
  @keyframes chat-in {
    from { opacity: 0; transform: translateY(10px) scale(0.96); }
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 14px 16px 18px;
    background: var(--primary);
    color: var(--white);
  }
  .chat-head strong {
    display: block;
    font-size: 15px;
    font-weight: 500;
  }
  .chat-head small {
    display: block;
    font-size: 12.5px;
    color: var(--accent-tint);
  }
  .chat-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--white);
  }
  .chat-close {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--white);
    transition: background-color 0.2s;
  }
  .chat-close:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .chat-body {
    padding: 20px 18px;
    background: var(--cloud-mist);
  }
  .chat-bubble {
    margin: 0;
    max-width: 92%;
    padding: 12px 14px;
    border-radius: 4px var(--radius-sm) var(--radius-sm) var(--radius-sm);
    background: var(--white);
    box-shadow: var(--shadow);
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--text);
  }

  .chat-actions {
    display: grid;
    gap: 10px;
    padding: 16px 18px 18px;
  }
  .chat-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: 999px;
    color: var(--white);
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .chat-btn:hover {
    color: var(--white);
  }
  .chat-btn-wa {
    background: var(--whatsapp);
  }
  .chat-btn-wa:hover {
    background: var(--whatsapp-dark);
  }
  .chat-btn-ms {
    background: var(--messenger);
  }
  .chat-btn-ms:hover {
    background: var(--messenger-dark);
  }

  /* Reduced motion: no pulse or icon swap; the toggle stays WhatsApp green */
  @media (prefers-reduced-motion: reduce) {
    .chat-toggle,
    .chat-toggle::before,
    .chat-icon-wa,
    .chat-card {
      animation: none;
    }
    .chat-icon-ms {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-chat]");
  const toggle = root?.querySelector<HTMLButtonElement>("[data-chat-toggle]");
  const card = root?.querySelector<HTMLElement>("[data-chat-card]");
  const setOpen = (open: boolean) => {
    if (!root || !toggle || !card) return;
    root.classList.toggle("is-open", open);
    card.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close chat" : "Chat with us");
  };
  toggle?.addEventListener("click", () => setOpen(card?.hidden ?? false));
  root?.querySelector("[data-chat-close]")?.addEventListener("click", () => {
    setOpen(false);
    toggle?.focus();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && root?.classList.contains("is-open")) {
      setOpen(false);
      toggle?.focus();
    }
  });
  document.addEventListener("click", (e) => {
    if (root?.classList.contains("is-open") && !root.contains(e.target as Node)) setOpen(false);
  });
</script>
