---
import Icon from "./Icon.astro";
---

<!-- Fixed back-to-top button; the teal ring fills as the page scrolls -->
<button type="button" class="to-top" aria-label="Back to top" data-to-top>
  <svg class="ring" viewBox="0 0 52 52" aria-hidden="true">
    <circle cx="26" cy="26" r="24" class="ring-bg"></circle>
    <circle cx="26" cy="26" r="24" class="ring-fill" data-ring></circle>
  </svg>
  <Icon name="arrow-up" size={18} />
</button>

<style>
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--white);
    color: var(--accent);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.3s,
      transform 0.3s,
      visibility 0.3s,
      background-color 0.3s,
      color 0.3s;
  }
  .to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .to-top:hover {
    background: var(--accent);
    color: var(--white);
  }
  .ring {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .ring circle {
    fill: none;
    stroke-width: 2;
  }
  .ring-bg {
    stroke: rgba(22, 122, 138, 0.25);
  }
  .ring-fill {
    stroke: var(--accent);
    stroke-dasharray: 150.8; /* 2πr, r = 24 */
    stroke-dashoffset: 150.8;
    transition: stroke-dashoffset 0.1s linear;
  }
  .to-top:hover .ring-fill {
    stroke: var(--white);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-to-top]");
  const ring = btn?.querySelector<SVGCircleElement>("[data-ring]");
  const LENGTH = 150.8;
  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const progress = max > 0 ? window.scrollY / max : 0;
    ring?.style.setProperty("stroke-dashoffset", String(LENGTH * (1 - progress)));
    btn?.classList.toggle("is-visible", window.scrollY > 400);
  };
  update();
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  btn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  });
</script>
