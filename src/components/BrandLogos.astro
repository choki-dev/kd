---
// Infinite logo marquee of Bhutan tourism partners (data in home.ts). Reduced motion: static row.
import { Image } from "astro:assets";
import { partners } from "../data/home";

// One row holds the list twice so it is wider than any screen; the second row is an aria-hidden copy for the seamless loop.
const row = [...partners, ...partners];
---

<section class="section brands" aria-label="Our partners">
  <div class="marquee">
    {
      [0, 1].map((copy) => (
        <ul class="marquee-row" aria-hidden={copy === 1 ? "true" : undefined}>
          {row.map((p, i) => (
            <li class:list={["brand", { "brand-wide": p.wide }]} aria-hidden={i >= partners.length ? "true" : undefined}>
              <Image src={p.logo} alt={copy === 0 && i < partners.length ? p.name : ""} height={p.wide ? 52 : 72} densities={[1, 2]} loading="lazy" class="brand-logo" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .marquee {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: 30px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-row {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 80px;
    padding-right: 80px;
    animation: marquee 40s linear infinite;
  }
  .marquee:hover .marquee-row {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-row {
      animation: none;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }
  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    height: 72px;
  }
  /* Greyed out at rest, full colour on hover */
  .brand :global(.brand-logo) {
    width: auto;
    height: 72px;
    filter: grayscale(1) brightness(0.8); /* slightly darker grey so the pale orange marks still read */
    opacity: 0.8;
    transition:
      filter 0.35s var(--ease),
      opacity 0.35s var(--ease);
  }
  .brand-wide :global(.brand-logo) {
    height: 52px;
  }
  .brand:hover :global(.brand-logo) {
    filter: none;
    opacity: 1;
  }
  @media (max-width: 767.98px) {
    .marquee-row {
      gap: 56px;
      padding-right: 56px;
    }
    .brand,
    .brand :global(.brand-logo) {
      height: 56px;
    }
    .brand-wide :global(.brand-logo) {
      height: 40px;
    }
  }
</style>
