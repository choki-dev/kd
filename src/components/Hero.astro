---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { heroActivities, heroSlides, site, socials } from "../data/home";
---

<section class="hero" aria-roledescription="carousel" aria-label="Featured trips" data-hero>
  <!-- Slides (stacked, cross-fade) -->
  {
    heroSlides.map((s, i) => (
      <div
        class:list={["hero-slide", { "is-active": i === 0 }]}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${heroSlides.length}`}
        aria-hidden={i === 0 ? "false" : "true"}
        data-slide
      >
        <Image
          src={s.image}
          alt={s.alt}
          width={1920}
          height={1080}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
          class="hero-img"
        />
        <div class="hero-overlay" />
        <div class="container hero-content">
          <p class="hero-kicker">{site.name} · {site.kicker}</p>
          {i === 0 ? <h1 class="hero-title">{s.title}</h1> : <p class="hero-title">{s.title}</p>}
          <p class="hero-text">{s.text}</p>
          <ul class="hero-chips" aria-label="Activities">
            {heroActivities.map((a) => (
              <li class="chip">
                <Icon name={a.icon} size={18} />
                {a.label}
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))
  }

  <!-- Left: follow us -->
  <div class="hero-social">
    <span class="follow">Follow us</span>
    <span class="follow-line" aria-hidden="true"></span>
    <ul>
      {
        socials.map((s) => (
          <li>
            <a href={s.href} class="social-circle" aria-label={s.label}>
              <Icon name={s.icon} size={16} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Right: arrows + counter -->
  <div class="hero-controls">
    <button type="button" class="hero-arrow" aria-label="Previous slide" data-hero-prev><Icon name="arrow-left" size={20} /></button>
    <p class="hero-counter" aria-live="polite">
      <span data-hero-current>1</span> / {heroSlides.length}
    </p>
    <button type="button" class="hero-arrow" aria-label="Next slide" data-hero-next><Icon name="arrow-right" size={20} /></button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: 680px;
    height: 100svh;
    max-height: 1100px;
    overflow: hidden;
    background: var(--primary);
    color: var(--white);
  }
  @media (max-height: 680px) {
    .hero {
      height: auto;
    }
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.1s var(--ease),
      visibility 1.1s;
  }
  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
  }
  .hero-slide :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 7s linear;
  }
  .hero-slide.is-active :global(.hero-img) {
    transform: scale(1);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(11, 61, 74, 0.6) 0%, rgba(11, 61, 74, 0.25) 45%, rgba(11, 61, 74, 0.7) 100%),
      rgba(45, 45, 45, 0.15);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-top: var(--header-h);
    padding-bottom: 120px; /* room for the overlapping search bar */
  }
  /* Spaced uppercase line, styled like "COMMERCE & SERVICES" in the logo */
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: clamp(11px, 0.2vw + 10px, 13px);
    font-weight: 500;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--accent-tint);
  }
  .hero-kicker::before,
  .hero-kicker::after {
    content: "";
    width: 36px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }
  @media (max-width: 575.98px) {
    .hero-kicker {
      letter-spacing: 0.2em;
    }
    .hero-kicker::before,
    .hero-kicker::after {
      display: none;
    }
  }
  .hero-title {
    margin-top: 18px;
    font-size: clamp(30px, 3vw + 12px, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--white);
  }
  .hero-text {
    max-width: 620px;
    margin: 22px auto 0;
    font-size: clamp(14px, 0.3vw + 13px, 16px);
    color: rgba(255, 255, 255, 0.88);
  }
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 32px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 15px;
    font-weight: 500;
  }
  .chip :global(svg) {
    color: var(--accent-tint);
  }

  /* Follow us (left edge, ≥992px) */
  .hero-social {
    display: none;
  }
  @media (min-width: 992px) {
    .hero-social {
      position: absolute;
      left: 28px;
      top: 50%;
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      transform: translateY(-50%);
    }
  }
  .follow {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }
  .follow-line {
    width: 1px;
    height: 48px;
    background: rgba(255, 255, 255, 0.4);
  }
  .hero-social ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .social-circle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }
  .social-circle:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  /* Arrows + counter (right edge on desktop, bottom-centre on small screens) */
  .hero-controls {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 92px;
    display: flex;
    align-items: center;
    gap: 14px;
    transform: translateX(-50%);
  }
  @media (min-width: 992px) {
    .hero-controls {
      left: auto;
      right: 28px;
      bottom: auto;
      top: 50%;
      flex-direction: column;
      transform: translateY(-50%);
    }
  }
  .hero-arrow {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: var(--white);
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }
  .hero-arrow:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  .hero-counter {
    min-width: 46px;
    text-align: center;
    font-weight: 500;
  }
  @media (max-width: 991.98px) {
    .hero-arrow {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  // Hero slider: fade between slides, autoplay every 6s (paused on hover/focus and for reduced motion)
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>("[data-slide]")];
    const current = hero.querySelector("[data-hero-current]");
    let index = 0;
    let timer: number | undefined;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.classList.toggle("is-active", n === index);
        s.setAttribute("aria-hidden", String(n !== index));
        s.toggleAttribute("inert", n !== index);
      });
      if (current) current.textContent = String(index + 1);
    };
    const play = () => {
      if (reduced) return;
      stop();
      timer = window.setInterval(() => show(index + 1), 6000);
    };
    const stop = () => window.clearInterval(timer);

    slides.forEach((s, n) => s.toggleAttribute("inert", n !== 0));
    hero.querySelector("[data-hero-prev]")?.addEventListener("click", () => (show(index - 1), play()));
    hero.querySelector("[data-hero-next]")?.addEventListener("click", () => (show(index + 1), play()));
    hero.addEventListener("mouseenter", stop);
    hero.addEventListener("mouseleave", play);
    hero.addEventListener("focusin", stop);
    hero.addEventListener("focusout", play);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : play()));
    play();
  }
</script>
