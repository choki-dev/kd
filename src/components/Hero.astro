---
import { Picture, getImage } from "astro:assets";
import Icon from "./Icon.astro";
import { heroSlides, site, socialLinkAttrs, socials } from "../data/home";

// Slides 2 and 3 are hidden at first, but the browser would still download them alongside slide 1 (they sit in the
// viewport). Their URLs go in data- attributes instead and the script below loads them once the page has loaded.
const imgSize = { width: 1920, height: 1080, widths: [640, 960, 1280, 1920] };
const deferred = await Promise.all(heroSlides.map((s) => getImage({ src: s.image, ...imgSize })));
---

<section class="hero" aria-roledescription="carousel" aria-label="Featured trips" data-hero>
  <!-- Slides (stacked, cross-fade) -->
  {
    heroSlides.map((s, i) => (
      <div
        class:list={["hero-slide", { "is-active": i === 0 }]}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${heroSlides.length}`}
        aria-hidden={i === 0 ? "false" : "true"}
        data-slide
      >
        {i === 0 ? (
          <Picture src={s.image} formats={["avif"]} fallbackFormat="webp" alt={s.alt} {...imgSize} sizes="100vw" loading="eager" fetchpriority="high" class="hero-img" />
        ) : (
          <img
            data-src={deferred[i].src}
            data-srcset={deferred[i].srcSet.attribute}
            alt={s.alt}
            width={imgSize.width}
            height={imgSize.height}
            sizes="100vw"
            decoding="async"
            class="hero-img"
          />
        )}
        <div class="hero-overlay" />
        <div class="container hero-content">
          <p class="hero-kicker">{site.kicker}</p>
          {i === 0 ? <h1 class="hero-title">{s.title}</h1> : <p class="hero-title">{s.title}</p>}
          <p class="hero-text">{s.text}</p>
        </div>
      </div>
    ))
  }

  <!-- Left: follow us -->
  <div class="hero-social">
    <span class="follow">Follow us</span>
    <span class="follow-line" aria-hidden="true"></span>
    <ul>
      {
        socials.map((s) => (
          <li>
            <a {...socialLinkAttrs(s.href)} class="social-circle" aria-label={s.label}>
              <Icon name={s.icon} size={16} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Right: arrows + counter -->
  <div class="hero-controls">
    <button type="button" class="hero-arrow" aria-label="Previous slide" data-hero-prev><Icon name="arrow-left" size={20} /></button>
    <p class="hero-counter" aria-live="polite">
      <span data-hero-current>1</span> / {heroSlides.length}
    </p>
    <button type="button" class="hero-arrow" aria-label="Next slide" data-hero-next><Icon name="arrow-right" size={20} /></button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: 680px;
    height: 100svh;
    max-height: 1100px;
    overflow: hidden;
    background: var(--primary);
    color: var(--white);
  }
  @media (max-height: 680px) {
    .hero {
      height: auto;
    }
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.1s var(--ease),
      visibility 1.1s;
  }
  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
  }
  .hero-slide :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 7s linear;
  }
  .hero-slide.is-active :global(.hero-img) {
    transform: scale(1);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 48%, rgba(0, 0, 0, 0.3), transparent 75%),
      linear-gradient(180deg, rgba(11, 61, 74, 0.7) 0%, rgba(11, 61, 74, 0.3) 45%, rgba(11, 61, 74, 0.8) 100%),
      rgba(20, 20, 20, 0.38);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-top: var(--header-h);
    padding-bottom: 120px; /* room for the overlapping search bar */
  }
  /* Script tagline (Parisienne), the same style as the section heads, in the teal tint for dark backgrounds */
  .hero-kicker {
    font-family: var(--font-display-script);
    font-size: clamp(30px, 1.6vw + 22px, 44px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--accent-tint);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }
  /* Editorial serif headline (Playfair Display); size kept from the earlier request */
  .hero-title {
    margin-top: 8px;
    font-family: var(--font-display-serif);
    font-size: clamp(30px, 3vw + 12px, 56px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--white);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.3);
  }
  .hero-text {
    max-width: 620px;
    margin: 22px auto 0;
    font-size: clamp(14px, 0.3vw + 13px, 16px);
    color: rgba(255, 255, 255, 0.88);
  }

  /* Follow us (left edge, ≥992px) */
  .hero-social {
    display: none;
  }
  @media (min-width: 992px) {
    .hero-social {
      position: absolute;
      left: 28px;
      top: 50%;
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      transform: translateY(-50%);
    }
  }
  .follow {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }
  .follow-line {
    width: 1px;
    height: 48px;
    background: rgba(255, 255, 255, 0.4);
  }
  .hero-social ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .social-circle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }
  .social-circle:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  /* Arrows + counter (right edge on desktop, bottom-centre on small screens) */
  .hero-controls {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 92px;
    display: flex;
    align-items: center;
    gap: 14px;
    transform: translateX(-50%);
  }
  @media (min-width: 992px) {
    .hero-controls {
      left: auto;
      right: 28px;
      bottom: auto;
      top: 50%;
      flex-direction: column;
      transform: translateY(-50%);
    }
  }
  .hero-arrow {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: var(--white);
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }
  .hero-arrow:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  .hero-counter {
    min-width: 46px;
    text-align: center;
    font-weight: 500;
  }
  @media (max-width: 991.98px) {
    .hero-arrow {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  // Hero slider: fade between slides, autoplay every 6s (paused on hover/focus and for reduced motion)
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>("[data-slide]")];
    const current = hero.querySelector("[data-hero-current]");
    let index = 0;
    let timer: number | undefined;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Load the deferred slide photos (see the frontmatter) after the page, or right away if a slide is shown first
    const loadSlides = () =>
      hero.querySelectorAll<HTMLImageElement>("img[data-src]").forEach((img) => {
        img.srcset = img.dataset.srcset ?? "";
        img.src = img.dataset.src ?? "";
        img.removeAttribute("data-src");
      });
    if (document.readyState === "complete") loadSlides();
    else window.addEventListener("load", loadSlides, { once: true });

    const show = (i: number) => {
      loadSlides();
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.classList.toggle("is-active", n === index);
        s.setAttribute("aria-hidden", String(n !== index));
        s.toggleAttribute("inert", n !== index);
      });
      if (current) current.textContent = String(index + 1);
    };
    const play = () => {
      if (reduced) return;
      stop();
      timer = window.setInterval(() => show(index + 1), 6000);
    };
    const stop = () => window.clearInterval(timer);

    slides.forEach((s, n) => s.toggleAttribute("inert", n !== 0));
    hero.querySelector("[data-hero-prev]")?.addEventListener("click", () => (show(index - 1), play()));
    hero.querySelector("[data-hero-next]")?.addEventListener("click", () => (show(index + 1), play()));
    hero.addEventListener("mouseenter", stop);
    hero.addEventListener("mouseleave", play);
    hero.addEventListener("focusin", stop);
    hero.addEventListener("focusout", play);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : play()));
    play();
  }
</script>
