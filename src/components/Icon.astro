---
// Inline SVG icons (line icons based on Lucide, ISC licence; social/store glyphs simplified).
// Usage: <Icon name="search" size={20} />  — decorative by default (aria-hidden); pass `label` to make it meaningful.
import type { IconName } from "../data/home";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className, label, strokeWidth = 1.6 } = Astro.props;

// Line icons: drawn with stroke
const stroke: Partial<Record<IconName, string>> = {
