---
import type { ImageMetadata } from "astro";
import { Font } from "astro:assets";
import ogPhoto from "../assets/images/tigers-nest-golden-light.jpg"; // = homepage slide 1
import "../styles/global.css";
import { site } from "../data/home";
import { absUrl, jsonLd, metaDescription, organizationSchema, shareImage } from "../utils/seo";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata; // social sharing photo (cropped to 1200×630); defaults to slide1.jpg
  imageAlt?: string;
  type?: "website" | "article";
  published?: string; // ISO date, articles only
  schema?: object | object[]; // page-specific schema.org items (JSON-LD), added to the site-wide organisation item
  noindex?: boolean; // keep the page out of search results (the 404 page)
}

const { title = site.title, image = ogPhoto, type = "website", published, schema = [] } = Astro.props;
const description = metaDescription(Astro.props.description ?? site.description);
const imageAlt = Astro.props.imageAlt ?? (Astro.props.image ? title : "Taktsang (Tiger's Nest) monastery on its cliff in golden evening light");

const ogImage = await shareImage(image);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isHome = Astro.url.pathname === import.meta.env.BASE_URL || Astro.url.pathname === import.meta.env.BASE_URL + "/";

const graph = [
  organizationSchema(),
  ...(isHome ? [{ "@type": "WebSite", "@id": absUrl("/#website"), name: site.name, url: absUrl("/"), inLanguage: "en" }] : []),
  ...(Array.isArray(schema) ? schema : [schema]),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!Astro.props.noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={Astro.props.noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#0b3d4a" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Social sharing -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- KD arc mark -->
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Brand fonts, self-hosted via the Astro Fonts API (see astro.config.mjs). Every page opens with a banner whose
         title is Playfair Display and tagline Parisienne, so those are preloaded too: the banner title is usually the
         page's Largest Contentful Paint. -->
    <Font cssVariable="--font-primary" preload={[{ weight: 400 }, { weight: 500 }]} />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-script" preload />

    <!-- Mark JS as available before first paint, so scroll-reveal content only hides when it can be revealed -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Structured data (schema.org) for search engines -->
    <script type="application/ld+json" set:html={jsonLd(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script>
      // Fade-in-on-scroll: any element with [data-reveal] gets .is-visible once it enters the viewport
      const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (!("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
