# KD Global — Apache settings for the live host (kdgocoms.com). Copied into dist/ by the build; ignored elsewhere
# (GitHub Pages, astro preview). Every block is wrapped in IfModule, so a missing module never breaks the site.

Options -Indexes
ErrorDocument 404 /404.html

# One address for search engines: http:// and www. both redirect (301) to https://kdgocoms.com
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Caching. Files in /_astro/ have a content hash in their name (a change gets a new name), so browsers can keep them
# for a year without asking again. Pages are rechecked after 10 minutes, so updates show up quickly.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#\.(png|ico|webmanifest)$#">
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
  <Else>
    Header set Cache-Control "public, max-age=600"
  </Else>
</IfModule>

# Compression for text files (photos and fonts are already compressed). Brotli where the host has it, else gzip.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>

# File types (most hosts know these already; listed so older servers label them correctly)
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
